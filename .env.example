SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave unset to fall back to SQLite (db.sqlite3). For Neon, paste the
# connection string from your Neon project's dashboard (it already
# includes ?sslmode=require) — looks like:
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Only needed in production (e.g. on Render) — must list the exact
# https:// origin(s) the app is served from, comma-separated.
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Django admin is served here instead of the guessable /admin/. Leave unset
# to use the built-in default (see ADMIN_URL in settings.py).
# ADMIN_URL=your-own-obscure-path

# Enables /setup/?token=<this value> — a page for creating a superuser or
# running seed_demo without shell access (e.g. Render's free tier has none).
# Leave unset to disable that page entirely (it 404s). Treat the value as a
# secret: anyone with it can create an admin account.
# SETUP_TOKEN=a-long-random-value

# Leave EMAIL_HOST unset to print shipment-update emails to the console
# instead of sending them. To actually send via Gmail SMTP, use an App
# Password (myaccount.google.com/apppasswords) — not your normal password.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=notifications@yourdomain.com
#
# If your network blocks port 587 (some ISPs/sandboxes do — connection just
# times out), use SSL on port 465 instead:
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# (and drop EMAIL_USE_TLS)

SIM_DELAY_RATE=0.05
